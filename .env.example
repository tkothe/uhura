# --- ElevenLabs ---
ELEVENLABS_API_KEY=
# The generic "caller" agent and the imported Twilio number (IDs from the ElevenLabs dashboard)
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# How that number is connected to ElevenLabs: twilio or sip
UHURA_TELEPHONY=twilio
# Voice of the agent: an ElevenLabs voice id (voice menu → "Copy voice ID"). Empty keeps
# whatever is set in the dashboard. Applied by `uhura setup-agent`.
UHURA_VOICE_ID=
# Optional: a different voice for one language, e.g. UHURA_VOICE_ID_EN for English calls.
# Works for every language except the agent's default one (the first in disclosures.py).
UHURA_VOICE_ID_EN=
# Language model the agent uses (applied by `uhura setup-agent`)
UHURA_LLM=gemini-3.5-flash

# --- Uhura service ---
# Who may use the service: comma-separated name:token pairs. Generate each token and the
# tool secret with `openssl rand -hex 24`; the service refuses to start with these placeholders.
UHURA_TOKENS=erika:change-me
# Shared secret ElevenLabs sends when the agent calls our tools (header X-Uhura-Secret)
UHURA_TOOL_SECRET=change-me-too
# Where the database lives. Leave it unset: the default is data/uhura.db when run
# directly, and the Docker image uses /data/uhura.db. Set it only to move the database.
# UHURA_DB=data/uhura.db

# --- Guardrails ---
UHURA_ALLOWED_COUNTRIES=DE
UHURA_MONTHLY_MINUTES=120
UHURA_DAILY_CALLS=10
# Rehearsals use ElevenLabs credits too; each is closed after 10 minutes
UHURA_DAILY_REHEARSALS=20
# Progress reports from the agent during calls (on/off); a brief can override it per call
UHURA_PROGRESS=on
# Seconds the agent waits on the line for an answer to ask_principal (ElevenLabs caps tool calls)
UHURA_ASK_TIMEOUT=100
# Finished calls and their transcripts are deleted after this many days (0 = keep)
UHURA_RETENTION_DAYS=30

# --- Clients (CLI / MCP) ---
UHURA_URL=http://localhost:8787
UHURA_TOKEN=change-me
